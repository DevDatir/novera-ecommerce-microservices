# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# These are the same values k8s/base/novera-secret.yaml and
# k8s/base/novera-configmap.yaml carry for the Kubernetes deployment.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=changeme
JWT_EXPIRATION=86400000

# --- Razorpay (test keys from https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID=rzp_test_changeme
RAZORPAY_KEY_SECRET=changeme

# --- Per-service database URLs (Docker Compose service DNS name: postgres-db) ---
AUTH_DB_URL=jdbc:postgresql://postgres-db:5432/novera_auth_db
CART_DB_URL=jdbc:postgresql://postgres-db:5432/novera_cart_db
ORDER_DB_URL=jdbc:postgresql://postgres-db:5432/novera_orders
PAYMENT_DB_URL=jdbc:postgresql://postgres-db:5432/novera_payment_db
PRODUCT_DB_URL=jdbc:postgresql://postgres-db:5432/productdb

# --- Inter-service URLs (Docker Compose service DNS names) ---
AUTH_SERVICE_URL=http://authentication-service:8080
PRODUCT_SERVICE_URL=http://product-service:8081
CART_SERVICE_URL=http://cart-service:8082
ORDER_SERVICE_URL=http://order-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8084
GATEWAY_SERVICE_URL=http://gateway-service:8085
